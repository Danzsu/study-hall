rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Trust vote tallies — publicly readable, writable only by authenticated users
    match /questionTrustVotes/{docId} {
      allow read;
      allow write: if request.auth != null;
    }

    // Per-user vote records — owned exclusively by the authenticated user
    match /userVotes/{userId}/questionVotes/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
