{
  "name": "study-hall",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:blackbox": "node tests/blackbox-smoke.js && node tests/blackbox-api-contract.js && node tests/blackbox-upload-auth.js && node tests/blackbox-api-edge.js",
    "test:whitebox": "node tests/whitebox-content.js && node tests/whitebox-plan-contract.js && node tests/whitebox-lib-content.js",
    "test:pipeline": "node tests/backend-pipeline-smoke.js && python tests/backend-pipeline-whitebox.py",
    "test:smoke": "npm run test:whitebox && npm run test:blackbox",
    "test:all": "npm run test:unit && npm run test:whitebox && npm run test:pipeline && npm run lint",
    "plan:content": "node scripts/build-content-plan.js",
    "validate:content": "node scripts/validate-content.js",
    "generate:content": "node scripts/generate-all.js",
    "check:backend": "node scripts/check-backend.js"
  },
  "dependencies": {
    "firebase": "^12.13.0",
    "firebase-admin": "^13.9.0",
    "groq-sdk": "^0.7.0",
    "katex": "^0.16.11",
    "lucide-react": "^0.441.0",
    "mammoth": "^1.12.0",
    "mermaid": "^11.15.0",
    "next": "^14.2.20",
    "openai": "^6.37.0",
    "pdf-parse": "^2.4.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.6",
    "autoprefixer": "^10.4.19",
    "eslint": "^8",
    "eslint-config-next": "^14.2.20",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.1",
    "vitest": "^4.1.6"
  }
}
